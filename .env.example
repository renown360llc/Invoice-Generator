# Copy to .env for local dev. In production, set these in the Vercel project
# (Settings → Environment Variables). Never commit real secrets.

# --- Supabase (client + server) ---
# VITE_ prefixed values are exposed to the browser; the anon key is safe to expose
# because Row Level Security protects the data.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Email invoices (server-only, used by api/send-invoice.js) ---
# Create a Resend account (https://resend.com), verify your sending domain,
# then create an API key. RESEND_API_KEY must NOT have the VITE_ prefix so it
# stays server-side only.
RESEND_API_KEY=re_your_resend_api_key
# Must be an address on a domain you've verified in Resend.
# Format: "Display Name <billing@yourdomain.com>"
FROM_EMAIL=Renown360 <billing@yourdomain.com>
